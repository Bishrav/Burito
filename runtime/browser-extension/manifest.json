{
  "manifest_version": 3,
  "name": "Burito Brave Control",
  "version": "1.4.0",
  "description": "Provides approved local tab lookup and visible-page controls for Burito.",
  "permissions": ["nativeMessaging", "offscreen"],
  "optional_permissions": ["tabs", "scripting", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Burito browser access" }
}
